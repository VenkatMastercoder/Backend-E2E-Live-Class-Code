datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Otp {
  otp_id String @id @default(cuid())
  channel String
  phone_number String
  otp_number String
  otp_status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CMSUser {
  cms_user_id String @id @default(cuid())
  role String
}