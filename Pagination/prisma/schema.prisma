generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  course_id    String   @id @default(uuid())
  sno          Int      @default(autoincrement())
  course_title String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}